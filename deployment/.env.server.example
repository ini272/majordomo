# Copy to /srv/majordomo/.env on the server and fill in the real values.

NODE_ENV=production
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:////data/majordomo.db
SQL_ECHO=false

# Leave blank for the reverse-proxied deployment unless you need direct cross-origin API access.
CORS_ORIGINS=

# Optional AI integration
GROQ_API_KEY=

# Frontend build/runtime
VITE_API_URL=/api
FRONTEND_PORT=80
